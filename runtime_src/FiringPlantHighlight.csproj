<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「发射位高亮」Mod —— 托管运行时程序集。

    刻意不用 Godot.NET.Sdk（要联网还原包 + 源码生成器）；本入口**不创建任何 Node 子类**
    （无脚本生成器时引擎不会回调自定义 Node 的 _Process/_Draw，本工程照抄 PlantPlacementMarker
    的结论），只用宿主公开 API + SceneTree 的 process_frame 回调驱动。

    入口程序集**身份名**用唯一名 JTYFiringPlantHighlight，避免与其他 Mod 的 "ModAssembly" 撞车；
    打包环节会改名为 ModAssembly.dll 放进包内 Runtime/（mod.json 的 runtimeAssembly 是
    硬编码字面量，文件名不可变，改的只是"身份"）。
    ⚠️ 安卓要求程序集名全局唯一 ⇒ 不要改成 ModAssembly / JTYShovelPosition / JTYGlove 等已有名字。
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>JTYFiringPlantHighlight</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <!-- 游戏程序集是 net9.0；压掉 MSB3277 版本冲突警告（否则构建日志膨胀、耗时变长） -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- 由构建脚本传 -p:GodotRefDir=... 覆盖（值来自 mods/_modenv.py） -->
    <GodotRefDir Condition="'$(GodotRefDir)' == ''"></GodotRefDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：26MB 的游戏程序集不进输出，运行时由引擎自己那份解析 -->
    <Reference Include="GodotSharp">
      <HintPath>$(GodotRefDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlantsVsZombies">
      <HintPath>$(GodotRefDir)\PlantsVsZombies.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
